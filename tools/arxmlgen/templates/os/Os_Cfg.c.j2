{% include "common/file_header.j2" %}
#include "Os_Cfg_{{ prefix_pascal }}.h"

/* ==================================================================
 * S-OS-11 design notes
 *
 * Expiry-point offset rule: each period group gets ONE repeating
 * schedule table with Duration == period and a single expiry point at
 * offset == period, started at absolute tick 0. The group task is
 * therefore activated exactly at the counter ticks where the legacy
 * dispatcher (Rte_DispatchRunnables) fired the group's runnables
 * (tick % period == 0). Offsets are deliberately NOT staggered across
 * groups: staggering would shift activation phase and break the
 * S-OS-11 order-equivalence proof. Same-tick pileup is resolved by
 * task priority (shorter period = higher priority = runs first); the
 * generator refuses any ECU where that resolution would change the
 * legacy execution order.
 *
 * WdgM note: this file carries only kernel tables. The task BODIES —
 * including runnable dispatch order and WdgM_CheckpointReached calls
 * replicated from Rte_DispatchRunnables — are generated separately in
 * Rte_TaskBodies_{{ prefix_pascal }}.c.
 * ================================================================== */

/* ==================================================================
 * Task table — one basic task per period group + idle
 * Idle-task convention (kernel os_cfg_validate_idle_task, FMEA
 * OS-C-03): priority OS_MAX_PRIORITIES-1, autostarted in
 * OSDEFAULTAPPMODE, FULL. Its body never terminates (Assumption of Use).
 * ================================================================== */

static const Os_TaskConfigType {{ ecu.name }}_os_task_cfg[OS_TASK_COUNT_{{ prefix_upper }}] = {
    /* Name, Entry, Priority, ActivationLimit, AutostartMask, Extended, Schedule */
{% for g in groups %}
    { "{{ g.cfg_name }}", {{ g.task_name }}, {{ g.prio_define }}, 1u, 0u, FALSE, {{ scheduling }} },
{% endfor %}
    { "{{ prefix_pascal }}_Idle", {{ idle_task_name }}, (uint8)(OS_MAX_PRIORITIES - 1u), 1u, 1u, FALSE, FULL },
};

/* ==================================================================
 * Schedule tables — one repeating table per period group
 * ================================================================== */

{% for g in groups %}
static const Os_ExpiryPointConfigType {{ g.ep_symbol }}[1] = {
    /* Offset, TaskID, EventMask */
    { {{ g.period }}u, {{ g.task_define }}, 0u },
};
{% endfor %}

static const Os_ScheduleTableConfigType {{ ecu.name }}_os_sched_table_cfg[OS_SCHED_TABLE_COUNT_{{ prefix_upper }}] = {
    /* Name, Duration, Repeating, ExpiryPoints, ExpiryPointCount */
{% for g in groups %}
    { "{{ g.cfg_name }}", {{ g.period }}u, TRUE, {{ g.ep_symbol }}, 1u },
{% endfor %}
};

/* ==================================================================
 * Stack budgets (Os_StackMonitorConfigType) — from sidecar os: section
 * ================================================================== */

static const Os_StackMonitorConfigType {{ ecu.name }}_os_stack_cfg[OS_TASK_COUNT_{{ prefix_upper }}] = {
    /* TaskID, BudgetBytes */
{% for g in groups %}
    { {{ g.task_define }}, {{ g.stack_bytes }}u },
{% endfor %}
    { {{ idle_task_define }}, {{ idle_stack_bytes }}u },
};

/* ==================================================================
 * Task stack storage (Os_TaskStackConfigType) — S-OS-31 launch seam.
 * StartOS builds each task's initial PSP frame at the top of these
 * arrays via the port task-binding seam and launches the first task
 * through Os_PortStartFirstTask. 8-byte aligned (AAPCS); sizes equal
 * the monitor budgets above (kernel os_cfg_apply_task_stacks requires
 * budget <= storage).
 * ================================================================== */

{% for g in groups %}
static uint8 {{ ecu.name }}_os_stack_{{ g.period }}ms[{{ g.stack_bytes }}] __attribute__((aligned(8)));
{% endfor %}
static uint8 {{ ecu.name }}_os_stack_idle[{{ idle_stack_bytes }}] __attribute__((aligned(8)));

static const Os_TaskStackConfigType {{ ecu.name }}_os_task_stack_cfg[OS_TASK_COUNT_{{ prefix_upper }}] = {
    /* TaskID, StackBase, SizeBytes */
{% for g in groups %}
    { {{ g.task_define }}, {{ ecu.name }}_os_stack_{{ g.period }}ms, {{ g.stack_bytes }}u },
{% endfor %}
    { {{ idle_task_define }}, {{ ecu.name }}_os_stack_idle, {{ idle_stack_bytes }}u },
};
{% if applications %}

/* ==================================================================
 * OS-Applications (sidecar os.applications)
 * ================================================================== */

static const Os_ApplicationConfigType {{ ecu.name }}_os_app_cfg[{{ applications|length }}] = {
{% for app in applications %}
    { "{{ app.name }}", {{ "TRUE" if app.trusted else "FALSE" }},
      {{ app.task_mask|hex }}u, {{ app.task_mask|hex }}u,
      0u, 0u, 0u, 0u, 0u, 0u },
{% endfor %}
};
{% endif %}

/* ==================================================================
 * Aggregate kernel configuration
 * ================================================================== */

const Os_ConfigType {{ ecu.name }}_os_config = {
    .Tasks = {{ ecu.name }}_os_task_cfg,
    .TaskCount = OS_TASK_COUNT_{{ prefix_upper }},
    .Resources = NULL_PTR,
    .ResourceCount = 0u,
    .Alarms = NULL_PTR,
    .AlarmCount = 0u,
    .ScheduleTables = {{ ecu.name }}_os_sched_table_cfg,
    .ScheduleTableCount = OS_SCHED_TABLE_COUNT_{{ prefix_upper }},
{% if applications %}
    .Applications = {{ ecu.name }}_os_app_cfg,
    .ApplicationCount = {{ applications|length }}u,
{% else %}
    .Applications = NULL_PTR,
    .ApplicationCount = 0u,
{% endif %}
    .TrustedFunctions = NULL_PTR,
    .TrustedFunctionCount = 0u,
    .Iocs = NULL_PTR,
    .IocCount = 0u,
    .Stacks = {{ ecu.name }}_os_stack_cfg,
    .StackCount = OS_TASK_COUNT_{{ prefix_upper }},
    .MemoryRegions = NULL_PTR,
    .MemoryRegionCount = 0u,
    .MemProtTasks = NULL_PTR,
    .MemProtTaskCount = 0u,
    .TaskStacks = {{ ecu.name }}_os_task_stack_cfg,
    .TaskStackCount = OS_TASK_COUNT_{{ prefix_upper }},
};

/**
 * @brief   Start all period-group schedule tables at absolute tick 0
 * @return  E_OK, or the last non-OK status from StartScheduleTableAbs
 * @note    Task context only (SC3 service protection). The kernel
 *          processes expiry points from the NEXT counter tick, so an
 *          absolute start of 0 fires each table first at tick == period
 *          — the legacy dispatcher's phase.
 */
StatusType {{ prefix_pascal }}_Os_StartScheduleTables(void)
{
    StatusType status = E_OK;
    uint8 idx;

    for (idx = 0u; idx < OS_SCHED_TABLE_COUNT_{{ prefix_upper }}; idx++) {
        StatusType table_status = StartScheduleTableAbs((ScheduleTableType)idx, 0u);
        if (table_status != E_OK) {
            status = table_status;
        }
    }

    return status;
}
